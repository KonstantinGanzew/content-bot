# Пример переменных окружения для Parser Bot
# Скопируйте этот файл в .env и заполните своими значениями

# ===========================================
# TELEGRAM BOT SETTINGS
# ===========================================
# Токен вашего Telegram бота (получить у @BotFather)
TELEGRAM_BOT_TOKEN=1234567890:ABCDEF_your_bot_token_here

# ID канала или чата куда отправлять посты (с минусом для каналов)
TELEGRAM_CHANNEL_ID=-1001234567890

# ===========================================
# PARSER SETTINGS
# ===========================================
# Режим работы: scheduler, test или cleanup
BOT_MODE=scheduler

# Интервал между циклами парсинга (в секундах)
PARSER_INTERVAL=300

# Максимальное количество постов за один раз
MAX_POSTS_PER_CYCLE=10

# ===========================================
# LOGGING SETTINGS
# ===========================================
# Уровень логирования: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO

# Записывать логи в файл
LOG_TO_FILE=true

# Максимальный размер лог файла (MB)
MAX_LOG_SIZE=10

# Количество архивных лог файлов
LOG_BACKUP_COUNT=5

# ===========================================
# MEDIA STORAGE SETTINGS
# ===========================================
# Включить сохранение медиа на диск
SAVE_IMAGES=true

# Организовать файлы по датам
ORGANIZE_BY_DATE=true

# Максимальная длина имени файла
MAX_FILENAME_LENGTH=100

# ===========================================
# AUTO CLEANUP SETTINGS
# ===========================================
# Включить автоматическую очистку старых файлов
AUTO_CLEANUP_ENABLED=true

# Интервал между очистками (в часах)
CLEANUP_INTERVAL_HOURS=1

# Сколько часов хранить файлы
FILES_KEEP_HOURS=48

# Максимальное количество файлов в день
MAX_FILES_PER_DAY=1000

# ===========================================
# REDDIT PARSER SETTINGS
# ===========================================
# Название subreddit для парсинга
REDDIT_SUBREDDIT=KafkaFPS

# Использовать JSON API Reddit (рекомендуется)
REDDIT_USE_JSON_API=true

# Задержка между запросами к Reddit (в секундах)
REDDIT_REQUEST_DELAY=3

# Минимальный рейтинг поста для парсинга
REDDIT_MIN_SCORE=1

# Фильтровать NSFW контент
REDDIT_FILTER_NSFW=false

# ===========================================
# JOYREACTOR PARSER SETTINGS  
# ===========================================
# Тэги для парсинга JoyReactor
JOYREACTOR_TAGS=game,gif

# Фильтровать посты с низким рейтингом
JOYREACTOR_FILTER_ENABLED=true

# Минимальный рейтинг для JoyReactor
JOYREACTOR_MIN_RATING=6.0

# ===========================================
# PERFORMANCE SETTINGS
# ===========================================
# Таймаут HTTP запросов (в секундах)
HTTP_TIMEOUT=30

# Максимальное количество одновременных соединений
MAX_CONNECTIONS=10

# Размер пула соединений
CONNECTION_POOL_SIZE=20

# ===========================================
# DOCKER SPECIFIC SETTINGS
# ===========================================
# Путь к директории с данными внутри контейнера
DATA_DIR=/app/data

# Путь к директории с медиа внутри контейнера  
IMAGES_DIR=/app/downloaded_images

# Путь к директории с логами внутри контейнера
LOGS_DIR=/app/logs 